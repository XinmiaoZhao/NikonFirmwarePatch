    "%@ was used on this Mac for a different selection. Choose another version so two different packages do not show the same version on the camera." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上曾用 %@ 构建过另一组功能。建议换一个版本号，以免两个不同的包在相机里显示相同的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 曾以 %@ 建置過另一組功能。建議換一個版本號碼，以免兩個不同的包在相機裡顯示相同的版本。"
          }
        }
      }
    },
